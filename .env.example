# Database Configuration
# In production / Docker: postgresql://freightiq:freightiq_pass@localhost:5432/freightiq_db
# Leave empty or set to sqlite:///./freightiq.db for local development fallback
DATABASE_URL=sqlite:///./freightiq.db

# Authentication Security
JWT_SECRET=super_secret_freightiq_enterprise_key_2025_maritime_ai
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Real Data vs Seeded Demo Mode
USE_REAL_DATA=false

# External Real Data APIs (Optional, used when USE_REAL_DATA=true)
WEATHER_API_KEY=
MARINE_API_KEY=
MAP_API_KEY=
AI_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
